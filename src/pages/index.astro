---

<BaseLayout
  nav="v2"
  title="Tavi notikumi. Mūsu talanti."
  description="STUDEJA rada mūziku, veido programmas un organizē pasākumus no sākuma līdz beigām."
>
  <!-- Hero -->
  <SectionHeroV2
    headings={headings}
    text="Tavam pasākumam piemeklējam mūziķus, saliekam programmu un noorganizējam norisi no sākuma līdz beigām."
    buttonLabel="SĀKAM AR SARUNU"
    buttonHoverLabel="PARUNUOSIM?"
    buttonHref="/pieteikums"
    media={media}
  />

  <!-- Programmes -->
  <SectionProgrammesV2
    heading="Koncertprogrammas un mākslinieki"
    text="Dažādu žanru grupas un solisti, kuri spēj saviļņot tavu publiku."
    filters={programmeFilters}
    programmes={programmes}
    linkLabel="SKATĪT KATALOGU"
    linkHoverLabel="APSAVĒRT VYSU"
    linkHref="/meklet?tips=koncertprogrammas"
  />

  <!-- Services -->
  <SectionServicesV2
    heading="Ar ko varam palīdzēt"
    filters={serviceFilters}
    services={services}
  />

  <!-- Feed -->
  <SectionFeedV2
    heading="@siastudeja jaunumi"
    elfsightId="a546cf55-7526-46c7-956c-88807ed4eedc"
    socials={socials}
  />
</BaseLayout>
