---
import Icon from "@/components/Media/Icon.astro";
import searchMark from "@/assets/icons/streamline/search.svg";
import { SEARCH_INDEX } from "@/consts.ts";

import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** What the trigger in the bar says. */
  label?: string;
};

const {
  render = true,
  label = "Meklēt",
  class: className,
  ...rest
} = Astro.props;
---

{
  render && (
    <Fragment>
      <button
        class:list={["search_trigger", className]}
        type="button"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="site-search"
        {...rest}
      >
        <Icon class="search_mark" src={searchMark} variant="small" />
        {label}
      </button>

      <div class="search_wrap" id="site-search" hidden>
        <div class="search_scrim" data-search-close />
        <div
          class="search_panel"
          role="dialog"
          aria-modal="true"
          aria-label="Meklēt vietnē"
        >
          <div class="search_field">
            <label class="search_label" for="search-input">
              Meklēt vietnē
            </label>
            <input
              class="search_input"
              id="search-input"
              type="search"
              autocomplete="off"
              spellcheck="false"
              placeholder="Meklē sadaļu, pakalpojumu vai kontaktu"
              aria-describedby="search-status"
            />
          </div>
          <p class="search_status text-style-small" id="search-status" role="status" />
          <ul class="search_results" />
        </div>
      </div>

      <script
        is:inline
        type="application/json"
        data-search-index
        set:html={JSON.stringify(SEARCH_INDEX)}
      />
    </Fragment>
  )
}

<script>
  type Entry = {
    title: string;
    text: string;
    href: string;
    group: string;
    keywords?: string;
  };

  const wrap = document.querySelector<HTMLElement>(".search_wrap");
  const trigger = document.querySelector<HTMLButtonElement>(".search_trigger");
  const input = document.querySelector<HTMLInputElement>(".search_input");
  const list = document.querySelector<HTMLUListElement>(".search_results");
  const status = document.querySelector<HTMLElement>(".search_status");
  const raw = document.querySelector<HTMLScriptElement>("[data-search-index]");

  if (wrap && trigger && input && list && status && raw) {
    const entries: Entry[] = JSON.parse(raw.textContent || "[]");
    let cursor = -1;
    let shown: Entry[] = [];

    /* Latvian diacritics are dropped on both sides, so "makslinieki" finds
       "Mākslinieki" and a keyboard without ā still works. */
    const plain = (value: string) =>
      value
        .toLowerCase()
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "");

    const score = (entry: Entry, query: string) => {
      const title = plain(entry.title);
      const haystack = plain(
        `${entry.title} ${entry.text} ${entry.group} ${entry.keywords ?? ""}`,
      );
      if (title.startsWith(query)) return 3;
      if (title.includes(query)) return 2;
      if (haystack.includes(query)) return 1;
      return 0;
    };

    const render = (query: string) => {
      const q = plain(query.trim());
      shown = !q
        ? entries.slice(0, 6)
        : entries
            .map((entry) => ({ entry, rank: score(entry, q) }))
            .filter((hit) => hit.rank > 0)
            .sort((a, b) => b.rank - a.rank)
            .map((hit) => hit.entry)
            .slice(0, 8);

      cursor = -1;
      list.innerHTML = shown
        .map(
          (entry, index) => `
            <li class="search_result">
              <a class="search_hit" href="${entry.href}" data-index="${index}">
                <span class="search_hit_group text-style-small">${entry.group}</span>
                <span class="search_hit_title">${entry.title}</span>
                <span class="search_hit_text text-style-small">${entry.text}</span>
              </a>
            </li>`,
        )
        .join("");

      if (!q) status.textContent = "Populārākās sadaļas";
      else if (shown.length === 0)
        status.textContent = `Nekas neatbilst vārdam "${query.trim()}". Pamēģini citu vārdu vai raksti uz info@studeja.lv.`;
      else
        status.textContent = `${shown.length} ${shown.length === 1 ? "atbilde" : "atbildes"}`;
    };

    const focusHit = (next: number) => {
      const hits = list.querySelectorAll<HTMLAnchorElement>(".search_hit");
      if (hits.length === 0) return;
      cursor = (next + hits.length) % hits.length;
      hits[cursor].focus();
    };

    const setOpen = (open: boolean) => {
      wrap.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
      document.body.classList.toggle("search-open", open);
      if (open) {
        render("");
        input.value = "";
        input.focus();
      } else {
        trigger.focus();
      }
    };

    trigger.addEventListener("click", () => setOpen(wrap.hidden !== false));

    wrap.querySelectorAll("[data-search-close]").forEach((element) => {
      element.addEventListener("click", () => setOpen(false));
    });

    input.addEventListener("input", () => render(input.value));

    wrap.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        setOpen(false);
      } else if (event.key === "ArrowDown") {
        event.preventDefault();
        focusHit(cursor + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        if (cursor <= 0) input.focus(), (cursor = -1);
        else focusHit(cursor - 1);
      }
    });

    /* A result on the current page is a jump, not a navigation, so the panel
       gets out of the way itself. */
    list.addEventListener("click", () => setOpen(false));

    document.addEventListener("keydown", (event) => {
      const typing =
        document.activeElement instanceof HTMLInputElement ||
        document.activeElement instanceof HTMLTextAreaElement;
      if (event.key === "/" && !typing && wrap.hidden !== false) {
        event.preventDefault();
        setOpen(true);
      }
    });
  }
</script>

<style is:global>
  @layer components {
    .search_trigger {
      cursor: pointer;
      font: inherit;
    }

    .search_mark {
      width: 1.1em;
      opacity: 0.85;
    }

    body.search-open {
      overflow: hidden;
    }

    .search_wrap {
      position: fixed;
      inset: 0;
      z-index: 300;
      display: grid;
      justify-items: center;
      align-content: start;
      padding: var(--site-margin);
      padding-top: min(18vh, 8rem);
      &[hidden] {
        display: none;
      }
    }

    .search_scrim {
      position: absolute;
      inset: 0;
      background-color: color-mix(in srgb, var(--ink-950) 72%, transparent);
      backdrop-filter: blur(0.5rem);
      animation: search-scrim var(--open-duration) var(--open-ease) both;
    }

    .search_panel {
      position: relative;
      width: min(38rem, 100%);
      max-height: min(70vh, 34rem);
      display: flex;
      flex-direction: column;
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      box-shadow: 0 2rem 4rem -1rem rgb(0 0 0 / 0.6);
      overflow: clip;
      animation: search-panel var(--open-duration) var(--open-ease) both;
    }

    @keyframes search-scrim {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @keyframes search-panel {
      from {
        opacity: 0;
        translate: 0 -0.75rem;
        scale: 0.985;
      }
      to {
        opacity: 1;
        translate: 0 0;
        scale: 1;
      }
    }

    .search_field {
      padding: var(--space-4) var(--space-5);
      border-bottom: var(--border-width) solid var(--border);
    }

    .search_label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .search_input {
      width: 100%;
      background: none;
      border: 0;
      color: var(--text);
      font-size: var(--text-large);
      &::placeholder {
        color: var(--text-2);
      }
      &:focus {
        outline: none;
      }
      &::-webkit-search-cancel-button {
        filter: invert(1);
        opacity: 0.5;
      }
    }

    .search_status {
      padding: var(--space-3) var(--space-5) 0;
      color: var(--text-2);
    }

    .search_results {
      display: flex;
      flex-direction: column;
      padding: var(--space-3);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .search_hit {
      display: grid;
      gap: var(--space-1);
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-small);
      transition: background-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          background-color: color-mix(in lab, var(--text) 7%, transparent);
        }
      }
      &:focus-visible {
        background-color: color-mix(in lab, var(--text) 10%, transparent);
      }
    }

    .search_hit_group {
      color: var(--heading-accent);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
    }

    .search_hit_text {
      color: var(--text-2);
    }
  }
</style>
