---
import Icon from "@/components/Media/Icon.astro";
import Logo from "@/assets/logo/studeja-logo-wide.svg";
import searchMark from "@/assets/icons/streamline/search.svg";
import instagramMark from "@/assets/icons/streamline/instagram.svg";
import facebookMark from "@/assets/icons/streamline/facebook.svg";
import { SITE_NAME, SEARCH_INDEX } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The bar's call to action. It is the only one the drawer shows as well. */
  buttonLabel?: string;
  buttonLabelAlt?: string;
  drawerButtonLabel?: string;
  drawerButtonLabelAlt?: string;
  /** Where that call to action leads. */
  buttonHref?: string;
  /** What the search field says before anyone types. */
  searchPlaceholder?: string;
}

const {
  render = true,
  buttonLabel = "SAZINIES",
  buttonLabelAlt = "PASTUOSTI",
  drawerButtonLabel = "SAZINIES AR MUMS",
  drawerButtonLabelAlt = "PASTUOSTI PAR PASUOKUMU",
  buttonHref = "/pieteikums",
  searchPlaceholder = "Meklē",
} = Astro.props;

/* Seven links, and the hierarchy is the size they are set in rather than a
   second block underneath. The catalogue links open search on one type. */
const primary = [
  { label: "Koncertprogrammas", href: "/meklet?tips=koncertprogrammas" },
  { label: "Mākslinieki", href: "/meklet?tips=makslinieki" },
  { label: "Pakalpojumi", href: "/#pakalpojumi" },
];

const secondary = [
  { label: "Projekti", href: "/projekti" },
  { label: "Par STUDEJA", href: "/par-studeja" },
  { label: "Sadarbība", href: "/sadarbiba" },
  { label: "Kontakti", href: "/kontakti" },
];

const social = [
  {
    label: "Instagram",
    href: "https://www.instagram.com/siastudeja/",
    icon: instagramMark,
  },
  {
    label: "Facebook",
    href: "https://www.facebook.com/profile.php?id=61590559761386",
    icon: facebookMark,
  },
];
---

{
  render && (
    <header class="navv2_wrap" data-nav>
      <div class="navv2_inner">
        <a class="navv2_logo" href="/" aria-label={SITE_NAME}>
          <Logo class="navv2_logo_art" />
        </a>

        <div class="navv2_search">
          <div class="navv2_field">
            <Icon class="navv2_field_mark" src={searchMark} variant="small" />
            <label class="sr-only" for="navv2-search">
              Meklē vietnē
            </label>
            <input
              class="navv2_input"
              id="navv2-search"
              type="search"
              autocomplete="off"
              spellcheck="false"
              placeholder={searchPlaceholder}
              aria-expanded="false"
              aria-controls="navv2-results"
              aria-describedby="navv2-status"
            />
          </div>

          {/* Grows out of the field rather than covering the page. */}
          <div class="navv2_panel" id="navv2-results">
            <div class="navv2_panel_inner">
              <p
                class="navv2_panel_label text-style-small"
                id="navv2-status"
                role="status"
              />
              <ul class="navv2_results" />
              <button
                class="navv2_more text-style-small"
                type="button"
                hidden
              />
            </div>
          </div>
        </div>

        <div class="navv2_actions">
          <a class="navv2_cta" href={buttonHref}>
            <span class="navv2_roll">
              <span class="navv2_roll_label">{buttonLabel}</span>
              <span class="navv2_roll_label alt" aria-hidden="true">
                {buttonLabelAlt}
              </span>
            </span>
          </a>
          <button
            class="navv2_menu"
            type="button"
            aria-label="Izvēlne"
            aria-expanded="false"
            aria-controls="navv2-drawer"
          >
            <span class="navv2_menu_mark" aria-hidden="true" />
          </button>
        </div>
      </div>

      <div class="navv2_scrim" data-nav-close />

      <div class="navv2_drawer" id="navv2-drawer" aria-label="Izvēlne" hidden>
        <div class="navv2_drawer_top">
          <button
            class="navv2_close"
            type="button"
            aria-label="Aizvērt izvēlni"
          >
            <span class="navv2_close_mark" aria-hidden="true" />
          </button>
        </div>

        <nav class="navv2_nav" aria-label="Galvenā">
          <ul class="navv2_list">
            {primary.map((link) => (
              <li class="navv2_item">
                <a class="navv2_link" href={link.href}>
                  <span class="navv2_link_label">{link.label}</span>
                </a>
              </li>
            ))}
          </ul>

          <ul class="navv2_list quiet">
            {secondary.map((link) => (
              <li class="navv2_item">
                <a class="navv2_link" href={link.href}>
                  <span class="navv2_link_label">{link.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="navv2_drawer_foot">
          <a class="navv2_drawer_cta" href={buttonHref}>
            <span class="navv2_roll">
              <span class="navv2_roll_label">{drawerButtonLabel}</span>
              <span class="navv2_roll_label alt" aria-hidden="true">
                {drawerButtonLabelAlt}
              </span>
            </span>
          </a>

          <div class="navv2_utility text-style-small">
            <ul class="navv2_langs" aria-label="Valoda">
              <li>
                <a class="navv2_lang" href="/" aria-current="true">
                  LV
                </a>
              </li>
              <li>
                <a class="navv2_lang" href="/en/" hreflang="en">
                  EN
                </a>
              </li>
            </ul>
            <ul class="navv2_social">
              {social.map((item) => (
                <li>
                  <a
                    class="navv2_social_link"
                    href={item.href}
                    rel="noopener"
                    target="_blank"
                  >
                    <Icon
                      class="navv2_social_mark"
                      src={item.icon}
                      variant="small"
                    />
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <script
        is:inline
        type="application/json"
        data-navv2-index
        set:html={JSON.stringify(SEARCH_INDEX)}
      />
    </header>
  )
}

<script>
  type Entry = {
    title: string;
    text: string;
    href: string;
    group: string;
    keywords?: string;
    featured?: boolean;
  };

  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const raw = document.querySelector<HTMLScriptElement>("[data-navv2-index]");

  if (nav && raw) {
    const entries: Entry[] = JSON.parse(raw.textContent || "[]");
    const input = nav.querySelector<HTMLInputElement>(".navv2_input");
    const list = nav.querySelector<HTMLUListElement>(".navv2_results");
    const status = nav.querySelector<HTMLElement>(".navv2_panel_label");
    const more = nav.querySelector<HTMLButtonElement>(".navv2_more");
    const menu = nav.querySelector<HTMLButtonElement>(".navv2_menu");
    const close = nav.querySelector<HTMLButtonElement>(".navv2_close");
    const drawer = nav.querySelector<HTMLElement>(".navv2_drawer");

    /* Diacritics come off both sides, so "makslinieki" finds "Mākslinieki"
       and a keyboard without ā still works. */
    const plain = (value: string) =>
      value.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");

    const score = (entry: Entry, query: string) => {
      const title = plain(entry.title);
      const words = plain(`${entry.title} ${entry.text} ${entry.group}`);
      const keys = plain(entry.keywords ?? "");
      if (title.startsWith(query)) return 4;
      if (title.includes(query)) return 3;
      if (keys.includes(query)) return 2;
      if (words.includes(query)) return 1;
      return 0;
    };

    const escape = (value: string) =>
      value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    /* Empty field offers the few places most people want. Typing searches the
       whole index instead, so it turns up entries the offer never held. */
    const SHOWN = 5;
    const MOST = 8;

    const results = (query: string) => {
      const q = plain(query.trim());
      if (!q) return entries.filter((entry) => entry.featured);
      return entries
        .map((entry) => ({ entry, rank: score(entry, q) }))
        .filter((hit) => hit.rank > 0)
        .sort((a, b) => b.rank - a.rank)
        .map((hit) => hit.entry)
        .slice(0, MOST);
    };

    let cursor = -1;
    let expanded = false;

    const render = (query: string, keepExpanded = false) => {
      if (!list || !status) return;
      const all = results(query);
      if (!keepExpanded) expanded = false;
      const shown = expanded ? all : all.slice(0, SHOWN);
      const rest = all.length - shown.length;
      cursor = -1;
      list.innerHTML = shown
        .map(
          (entry, index) => `
            <li class="navv2_result">
              <a class="navv2_hit" href="${entry.href}" data-index="${index}">
                <span class="navv2_hit_title">${escape(entry.title)}</span>
                <span class="navv2_hit_text text-style-small">${escape(entry.text)}</span>
              </a>
            </li>`,
        )
        .join("");

      if (more) {
        more.hidden = rest <= 0;
        more.textContent = `Rādīt vēl ${rest}`;
      }

      const trimmed = query.trim();
      if (!trimmed) status.textContent = "Populārākās sadaļas";
      else if (all.length === 0)
        status.textContent = `Nekas neatbilst vārdam "${trimmed}". Raksti uz info@studeja.lv.`;
      else
        status.textContent = `${all.length} ${all.length === 1 ? "atbilde" : "atbildes"}`;
    };

    more?.addEventListener("click", () => {
      expanded = true;
      render(input?.value ?? "", true);
      input?.focus();
    });

    const openSearch = (open: boolean) => {
      const was = nav.classList.contains("search-open");
      nav.classList.toggle("search-open", open);
      input?.setAttribute("aria-expanded", String(open));
      /* Only on the way open, or refocusing the field would discard rows the
         visitor just revealed. */
      if (open && !was) render(input?.value ?? "");
    };

    input?.addEventListener("focus", () => openSearch(true));
    input?.addEventListener("input", () => {
      openSearch(true);
      render(input.value);
    });

    /* The field says what it is; the hint says what is in the index. It runs
       only while the field is idle and unfocused, holds each phrase for
       seconds rather than blinking, and never runs at all when motion is
       turned down. It is there to tell, not to catch the eye. */
    const BASE = input?.getAttribute("placeholder") ?? "Meklē";
    const HINTS = ["māksliniekus", "koncertprogrammas", "informāciju"];
    const stillPlaceholder = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    if (input && !stillPlaceholder.matches) {
      const field = input;
      const wait = (ms: number) => new Promise((done) => setTimeout(done, ms));
      const idle = () =>
        document.activeElement !== field &&
        field.value === "" &&
        !document.hidden;

      const settle = async () => {
        while (!idle()) {
          if (field.placeholder !== BASE) field.placeholder = BASE;
          await wait(400);
        }
      };

      void (async () => {
        await wait(4000);
        let turn = 0;
        for (;;) {
          await settle();
          const word = HINTS[turn++ % HINTS.length];
          for (let i = 1; i <= word.length && idle(); i++) {
            field.placeholder = `${BASE} ${word.slice(0, i)}`;
            await wait(60);
          }
          if (idle()) await wait(5000);
          for (let i = word.length; i > 0 && idle(); i--) {
            field.placeholder = `${BASE} ${word.slice(0, i - 1)}`.trimEnd();
            await wait(28);
          }
          field.placeholder = BASE;
          await wait(2500);
        }
      })();
    }

    const focusHit = (next: number) => {
      const hits = list?.querySelectorAll<HTMLAnchorElement>(".navv2_hit");
      if (!hits || hits.length === 0) return;
      cursor = (next + hits.length) % hits.length;
      hits[cursor].focus();
    };

    nav.querySelector(".navv2_search")?.addEventListener("keydown", (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === "Escape") {
        event.preventDefault();
        openSearch(false);
        input?.focus();
      } else if (key === "ArrowDown") {
        event.preventDefault();
        focusHit(cursor + 1);
      } else if (key === "ArrowUp") {
        event.preventDefault();
        if (cursor <= 0) {
          cursor = -1;
          input?.focus();
        } else focusHit(cursor - 1);
      }
    });

    /* A result on this page is a jump, so the panel gets out of the way. */
    list?.addEventListener("click", () => openSearch(false));

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (!nav.querySelector(".navv2_search")?.contains(target))
        openSearch(false);
    });

    document.addEventListener("keydown", (event) => {
      const typing =
        document.activeElement instanceof HTMLInputElement ||
        document.activeElement instanceof HTMLTextAreaElement;
      if (
        event.key === "/" &&
        !typing &&
        !nav.classList.contains("drawer-open")
      ) {
        event.preventDefault();
        input?.focus();
      }
    });

    /* --- drawer --- */
    const focusable = () =>
      [
        ...(drawer?.querySelectorAll<HTMLElement>(
          "a[href], button:not([disabled])",
        ) ?? []),
      ].filter((el) => el.offsetParent !== null);

    let restoreTo: HTMLElement | null = null;

    const setDrawer = (open: boolean) => {
      if (!drawer || !menu) return;
      if (open) {
        restoreTo = document.activeElement as HTMLElement;
        drawer.hidden = false;
        openSearch(false);
      }
      /* One frame with the panel in the tree before it slides, or the
         transition has nothing to run from. */
      requestAnimationFrame(() => {
        nav.classList.toggle("drawer-open", open);
        document.body.classList.toggle("navv2-locked", open);
        menu.setAttribute("aria-expanded", String(open));
        if (open) close?.focus();
      });
      if (!open) {
        window.setTimeout(() => {
          if (!nav.classList.contains("drawer-open")) drawer.hidden = true;
        }, 320);
        restoreTo?.focus();
      }
    };

    menu?.addEventListener("click", () =>
      setDrawer(menu.getAttribute("aria-expanded") !== "true"),
    );
    close?.addEventListener("click", () => setDrawer(false));
    nav
      .querySelectorAll("[data-nav-close]")
      .forEach((el) => el.addEventListener("click", () => setDrawer(false)));
    drawer
      ?.querySelectorAll("a[href]")
      .forEach((el) => el.addEventListener("click", () => setDrawer(false)));

    document.addEventListener("keydown", (event) => {
      if (!nav.classList.contains("drawer-open")) return;
      if (event.key === "Escape") {
        event.preventDefault();
        setDrawer(false);
      } else if (event.key === "Tab") {
        /* Tab stays inside the drawer while it covers the page. */
        const items = focusable();
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    /* The bar separates itself from the page only once the page has moved. */
    const sentinel = document.createElement("div");
    sentinel.setAttribute("aria-hidden", "true");
    sentinel.style.cssText = "position:absolute;top:0;height:1px;width:1px;";
    document.body.prepend(sentinel);
    new IntersectionObserver(
      ([entry]) => nav.classList.toggle("scrolled", !entry.isIntersecting),
      { threshold: 0 },
    ).observe(sentinel);

    render("");
  }
</script>

<style is:global>
  @layer components {
    /* Nothing in this bar carries a fill at rest. The page's own call to
       action keeps the only solid button on screen. */
    .navv2_wrap {
      --navv2-line: color-mix(in lab, var(--text) 18%, transparent);
      --navv2-line-lit: color-mix(in lab, var(--text) 38%, transparent);
      --navv2-glow: color-mix(in srgb, var(--sand-100) 20%, transparent);
      /* The filled CTA carries its own light, so its glow has to read
         against that fill rather than against the dark bar. */
      --navv2-glow-cta: color-mix(in srgb, var(--sand-100) 34%, transparent);
      --navv2-glow-cta-far: color-mix(
        in srgb,
        var(--sand-100) 18%,
        transparent
      );
      /* Glass rather than a dark slab: the page stays readable behind it. */
      --navv2-glass: color-mix(in srgb, var(--background-2) 55%, transparent);
      --navv2-bar: color-mix(in srgb, var(--ink-950) 38%, transparent);
      --navv2-blur: blur(1.75rem) saturate(1.5);

      /* Fixed over the page rather than sitting above it, so whatever is
         behind shows through the glass. The first section clears it with
         `--nav-height` of extra top padding. */
      position: fixed;
      inset-inline: 0;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      color: var(--text);
      border-bottom: var(--border-width) solid transparent;
      transition: border-color var(--hover-duration) var(--hover-ease);

      /* The glass sits on a pseudo-element, not on the bar itself. A
         `backdrop-filter` here would make the bar the containing block for
         its own fixed children, and the drawer scrim would shrink to the
         bar instead of covering the page. */
      &::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background-color: var(--navv2-bar);
        backdrop-filter: var(--navv2-blur);
        transition: background-color var(--hover-duration) var(--hover-ease);
      }

      &.scrolled {
        border-bottom-color: var(--navv2-line);
      }

      &:is(.search-open, .drawer-open)::before {
        background-color: color-mix(in srgb, var(--ink-950) 62%, transparent);
      }
    }

    body.navv2-locked {
      overflow: hidden;
    }

    .navv2_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: grid;
      grid-template-columns: 1fr minmax(0, 32rem) 1fr;
      align-items: center;
      gap: var(--space-5);
      min-height: var(--nav-height);
    }

    .navv2_logo {
      justify-self: start;
      display: flex;
      align-items: center;
      border-radius: var(--radius-small);
    }

    .navv2_logo_art {
      display: block;
      width: auto;
      height: 1.7rem;
      color: var(--text);
      transform-origin: left center;
      transition:
        scale var(--hover-duration) var(--hover-ease),
        filter calc(var(--hover-duration) * 1.6) var(--hover-ease);
      @media (width >= 48rem) {
        height: 2.05rem;
      }
    }

    @media (hover: hover) {
      .navv2_logo:hover .navv2_logo_art {
        scale: 1.035;
        filter: drop-shadow(0 0 0.5rem var(--navv2-glow-cta))
          drop-shadow(0 0 1.5rem var(--navv2-glow-cta-far));
      }
    }

    .navv2_logo:focus-visible .navv2_logo_art {
      filter: drop-shadow(0 0 0.5rem var(--navv2-glow-cta))
        drop-shadow(0 0 1.5rem var(--navv2-glow-cta-far));
    }

    /* Search */
    .navv2_search {
      position: relative;
      justify-self: stretch;
      width: 100%;
    }

    .navv2_field {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: 0.6em 0.95em;
      border: var(--border-width) solid var(--navv2-line);
      border-radius: var(--radius-main);
      color: var(--text-2);
      transition:
        border-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        box-shadow calc(var(--hover-duration) * 1.6) var(--hover-ease);

      @media (hover: hover) {
        &:hover {
          border-color: var(--navv2-line-lit);
          color: var(--text);
        }
      }
    }

    .navv2_wrap.search-open .navv2_field,
    .navv2_field:focus-within {
      border-color: var(--navv2-line-lit);
      color: var(--text);
      box-shadow: 0 0 2rem var(--navv2-glow);
    }

    .navv2_field_mark {
      width: 1.05em;
      flex: none;
    }

    .navv2_input {
      width: 100%;
      background: none;
      border: 0;
      color: var(--text);
      font: inherit;
      font-size: var(--text-small);
      &::placeholder {
        color: var(--text-2);
      }
      &:focus {
        outline: none;
      }
      &::-webkit-search-cancel-button {
        filter: invert(1);
        opacity: 0.45;
      }
    }

    /* The panel grows out of the field instead of covering the page. */
    /* The results are free to be wider than the field they came from. */
    .navv2_panel {
      position: absolute;
      top: calc(100% + var(--space-3));
      left: 50%;
      translate: -50% -0.35rem;
      width: min(40rem, calc(100vw - var(--site-margin) * 2));
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      background-color: var(--navv2-glass);
      backdrop-filter: var(--navv2-blur);
      border: var(--border-width) solid var(--navv2-line);
      border-radius: var(--radius-main);
      box-shadow: 0 1.5rem 3rem -1rem rgb(0 0 0 / 0.55);
      overflow: hidden;
      opacity: 0;
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        opacity var(--open-duration) var(--open-ease),
        translate var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .navv2_wrap.search-open .navv2_panel {
      grid-template-rows: 1fr;
      visibility: visible;
      opacity: 1;
      translate: -50% 0;
    }

    .navv2_panel_inner {
      overflow: hidden;
      min-height: 0;
      padding: var(--space-4);
    }

    /* Same horizontal inset as a row, so the label sits on their left edge. */
    .navv2_panel_label {
      padding: var(--space-1) var(--space-3) var(--space-4);
      color: var(--text-2);
    }

    .navv2_results {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      max-height: min(74vh, 44rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .navv2_more {
      width: 100%;
      margin-top: var(--space-3);
      padding: var(--space-3);
      color: var(--text-2);
      border: var(--border-width) solid var(--navv2-line);
      border-radius: var(--radius-small);
      cursor: pointer;
      transition:
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
          border-color: var(--navv2-line-lit);
        }
      }
      &[hidden] {
        display: none;
      }
    }

    .navv2_hit {
      display: grid;
      gap: 0.15rem;
      padding: var(--space-3);
      border-radius: var(--radius-small);
      transition: background-color var(--hover-duration) var(--hover-ease);
