---
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Choice from "@/components/Form/Choice.astro";
import Fieldset from "@/components/Form/Fieldset.astro";
import Form from "@/components/Form/Form.astro";
import Input from "@/components/Form/Input.astro";
import Textarea from "@/components/Form/Textarea.astro";

const genres = [
  "Pop",
  "Roks",
  "Alternatīvais",
  "Indie",
  "Metāls",
  "Panks",
  "Elektroniskā mūzika",
  "Hiphops / reps",
  "R&B / soul",
  "Fanks",
  "Džezs",
  "Etnojazz",
  "Blūzs",
  "Kantrī",
  "Bluegrass",
  "Folks",
  "Pasaules mūzika",
  "Klasiskā mūzika",
  "Reggae / ska",
  "Cits",
];

const DRIVE_FOLDER_URL =
  "https://drive.google.com/drive/folders/1csMs6MXedZUNR53e1e3waeBom_tQpgv2?usp=drive_link";
---

<div class="artist-intake_wrap" lang="lv">
  <Form
    name="studeja-artist-intake"
    action="/api/anketa"
    class="artist-intake_form"
    successMessage="Paldies! Jūsu informācija ir saņemta."
    errorMessage="Anketu neizdevās nosūtīt. Lūdzu, mēģiniet vēlreiz."
    data-artist-intake
  >
    <input type="hidden" name="pieteikuma-tips" data-intake-type />

    <fieldset class="artist-intake_type" data-type-picker>
      <legend class="artist-intake_label text-style-h5"
        >Par ko aizpildāt anketu?</legend
      >
      <p class="artist-intake_hint text-style-main">
        Izvēlieties vienu kategoriju, lai atvērtu atbilstošos jautājumus.
      </p>
      <div class="artist-intake_type-list">
        <button
          class="artist-intake_type-option"
          type="button"
          data-type="grupa"
          aria-pressed="false"
        >
          <span class="artist-intake_type-number">01</span>
          <span
            ><strong>Grupa</strong><small>Mūziķu apvienība vai projekts</small
            ></span
          >
        </button>
        <button
          class="artist-intake_type-option"
          type="button"
          data-type="muzikis"
          aria-pressed="false"
        >
          <span class="artist-intake_type-number">02</span>
          <span
            ><strong>Mūziķis</strong><small
              >Izpildītājs, ko var piesaistīt dažādiem sastāviem</small
            ></span
          >
        </button>
        <button
          class="artist-intake_type-option"
          type="button"
          data-type="partneris"
          aria-pressed="false"
        >
          <span class="artist-intake_type-number">03</span>
          <span
            ><strong>Partneris</strong><small
              >Pakalpojumu sniedzējs vai sadarbības partneris</small
            ></span
          >
        </button>
      </div>
    </fieldset>

    <section class="artist-intake_panel" data-panel="grupa" hidden>
      <Fieldset legend="Pamatinformācija" variant="columns">
        <Input label="Grupas nosaukums" name="grupas-nosaukums" required />
        <Fieldset legend="Repertuārs" variant="inline" legendStyle="label">
          <Choice
            type="radio"
            name="grupas-repertuars"
            label="Oriģinālmūzika"
            value="originalmuzika"
            required
          />
          <Choice
            type="radio"
            name="grupas-repertuars"
            label="Kaveri"
            value="kaveri"
          />
          <Choice
            type="radio"
            name="grupas-repertuars"
            label="Abi"
            value="abi"
          />
        </Fieldset>
      </Fieldset>

      <Fieldset legend="Žanri" legendStyle="label">
        <p class="artist-intake_hint text-style-main">
          Atzīmējiet līdz trim žanriem.
        </p>
        <div class="artist-intake_genres" data-genres>
          {
            genres.map((genre) => (
              <Choice
                label={genre}
                value={genre}
                name="grupas-zanri"
                variant="chip"
              />
            ))
          }
        </div>
        <Input
          label="Cits žanrs"
          name="grupas-cits-zanrs"
          placeholder="Norādiet savu žanru"
          data-other-genre
          disabled
        />
        <p
          class="artist-intake_limit text-style-small"
          data-genre-note
          aria-live="polite"
        >
        </p>
      </Fieldset>

      <Fieldset legend="Sastāvs un stāsts">
        <Textarea
          label="Cilvēki grupā"
          name="grupas-dalibnieki"
          placeholder="Vārds Uzvārds — instruments / loma"
          minLines={4}
          required
        />
        <Textarea
          label="Grupas apraksts"
          name="grupas-apraksts"
          placeholder="Aprakstiet grupu vismaz vienā 4–5 teikumu rindkopā: skanējumu, pieredzi, repertuāru un to, kas jūs raksturo."
          minLines={8}
          maxLines={22}
          minlength="250"
          required
        />
        <Textarea
          label="Apbalvojumi, sasniegumi un nozīmīgas uzstāšanās"
          name="grupas-sasniegumi"
          placeholder="Festivāli, konkursi, nozīmīgi pasākumi, sadarbības vai citi sasniegumi."
        />
      </Fieldset>

      <Fieldset legend="Mūzika un saites">
        <Textarea
          label="Līdz 5 dziesmu vai priekšnesumu saites"
          name="grupas-top-saites"
          placeholder="Ievietojiet katru saiti jaunā rindā. Ja nav ko pievienot, ierakstiet “nav”."
          minLines={5}
        />
        <Textarea
          label="Sociālie un citi linki"
          name="grupas-socialie-tikli"
          placeholder="Facebook, Instagram, YouTube, TikTok, Spotify, SoundCloud, Bandcamp un citas saites — katru jaunā rindā."
          minLines={5}
        />
      </Fieldset>

      <aside class="artist-intake_drive" aria-labelledby="group-drive-heading">
        <p class="artist-intake_kicker">Materiāli</p>
        <h3 id="group-drive-heading" class="text-style-h5">
          Google Drive mape
        </h3>
        <p class="text-style-main">
          Izveidojiet Google Drive mapi ar grupas nosaukumu un ievietojiet tajā
          logo, tehnisko raideri, foto, video un citus noderīgus materiālus mūsu
          kopīgajā Drive mapē.
        </p>
        <Button
          element="link"
          href={DRIVE_FOLDER_URL}
          target="_blank"
          rel="noreferrer">Atvērt kopīgo Google Drive mapi</Button
        >
      </aside>

      <Fieldset legend="Pasākumi un cena" variant="columns">
        <Textarea
          label="Kādos pasākumos uzstājaties?"
          name="grupas-pasakumi"
          placeholder="Festivāli, korporatīvie pasākumi, kāzas, koncerti u.c."
          required
        />
        <Textarea
          label="Standarta programmas garums un formāts"
          name="grupas-programma"
          placeholder="Piem., 1 h koncerts vai 3 × 40 min seti."
          required
        />
        <Input
          variant="text"
          label="Minimālā cena"
          name="grupas-min-cena"
          placeholder="Piem., no 1 200 EUR + PVN"
          required
        />
        <Input
          variant="text"
          label="Vēlamā cena"
          name="grupas-velama-cena"
          placeholder="Piem., 1 800 EUR + PVN"
        />
      </Fieldset>

      <Fieldset legend="Norēķini un kontakts" variant="columns">
        <Fieldset
          legend="Vai ir juridiska persona un/vai pašnodarbinātā statuss?"
          variant="inline"
          legendStyle="label"
        >
          <Choice
            type="radio"
            name="grupas-rekini"
            label="Jā"
            value="ja"
            required
          />
          <Choice type="radio" name="grupas-rekini" label="Nē" value="ne" />
          <Choice
            type="radio"
            name="grupas-rekini"
            label="Jāprecizē"
            value="japrecize"
          />
        </Fieldset>
        <Input
          label="Galvenās kontaktpersonas vārds, uzvārds"
          name="grupas-kontaktpersona"
          required
        />
        <Input variant="email" label="E-pasts" name="grupas-epasts" required />
        <Input
          variant="phone"
          label="Tālrunis"
          name="grupas-talrunis"
          required
        />
      </Fieldset>
      <Textarea
        label="Citas piezīmes"
        name="grupas-piezimes"
        placeholder="Viss, ko mums būtu svarīgi zināt par jūsu darbu vai organizēšanos."
      />
    </section>

    <section class="artist-intake_panel" data-panel="muzikis" hidden>
      <Fieldset legend="Pamatinformācija" variant="columns">
        <Input label="Vārds, uzvārds" name="muzika-vards" required />
        <Input
          label="Galvenais instruments vai loma"
          name="muzika-instruments"
          placeholder="Piem., kontrabass, bungas, vokāls"
          required
        />
        <Textarea
          label="Kādos sastāvos / grupās spēlējat?"
          name="muzika-grupas"
          placeholder="Norādiet grupu vai projektu nosaukumus."
          required
        />
        <Fieldset
          legend="Vai esat arī solo mākslinieks?"
          variant="inline"
          legendStyle="label"
        >
          <Choice
            type="radio"
            name="muzika-solo"
            label="Jā"
            value="ja"
            required
          />
          <Choice type="radio" name="muzika-solo" label="Nē" value="ne" />
        </Fieldset>
      </Fieldset>
      <Fieldset legend="Profils un pieredze">
        <Textarea
          label="Mūziķa apraksts"
          name="muzika-apraksts"
          placeholder="Īsi aprakstiet savu muzikālo pieredzi, stiprās puses, stilus un sadarbības formātus."
          minLines={6}
          required
        />
        <Textarea
          label="Sasniegumi un nozīmīgas uzstāšanās"
          name="muzika-sasniegumi"
          placeholder="Festivāli, ieraksti, projekti, apbalvojumi vai citi būtiski fakti."
        />
        <Textarea
          label="Līdz 5 saites uz ierakstiem vai priekšnesumiem"
          name="muzika-top-saites"
          placeholder="Katra saite jaunā rindā. Ja nav ko pievienot, ierakstiet “nav”."
          minLines={5}
        />
        <Textarea
          label="Sociālie un citi linki"
          name="muzika-socialie-tikli"
          placeholder="Instagram, Facebook, YouTube, Spotify, personīgā mājaslapa u.c."
          minLines={4}
        />
      </Fieldset>
      <aside
        class="artist-intake_drive"
        aria-labelledby="musician-drive-heading"
      >
        <p class="artist-intake_kicker">Materiāli</p>
        <h3 id="musician-drive-heading" class="text-style-h5">
          Google Drive mape
        </h3>
        <p class="text-style-main">
          Izveidojiet Google Drive mapi ar savu vārdu un uzvārdu. Pievienojiet
          foto, video, tehnisko informāciju un citus materiālus mūsu kopīgajā
          Drive mapē.
        </p>
        <Button
          element="link"
          href={DRIVE_FOLDER_URL}
          target="_blank"
          rel="noreferrer">Atvērt kopīgo Google Drive mapi</Button
        >
      </aside>
      <Fieldset legend="Pieejamība, cena un kontakts" variant="columns">
        <Textarea
          label="Kādos pasākumos vai formātos esat pieejams?"
          name="muzika-pasakumi"
          placeholder="Koncerti, studijas ieraksti, kāzas, privāti un korporatīvi pasākumi u.c."
        />
        <Textarea
          label="Standarta programmas garums vai darba formāts"
          name="muzika-programma"
          placeholder="Piem., 2 × 45 min, viena dziesma ierakstā, mēģinājumu diena."
        />
        <Input
          variant="text"
          label="Minimālā cena"
          name="muzika-min-cena"
          placeholder="Brīvā formātā"
        />
        <Input
          variant="text"
          label="Vēlamā cena"
          name="muzika-velama-cena"
          placeholder="Brīvā formātā"
        />
        <Fieldset
          legend="Vai varat izrakstīt rēķinu?"
          variant="inline"
          legendStyle="label"
        >
          <Choice
            type="radio"
            name="muzika-rekini"
            label="Jā"
            value="ja"
            required
          />
          <Choice type="radio" name="muzika-rekini" label="Nē" value="ne" />
          <Choice
            type="radio"
            name="muzika-rekini"
            label="Jāprecizē"
            value="japrecize"
          />
        </Fieldset>
        <Input variant="email" label="E-pasts" name="muzika-epasts" required />
        <Input
          variant="phone"
          label="Tālrunis"
          name="muzika-talrunis"
          required
        />
      </Fieldset>
      <Textarea label="Citas piezīmes" name="muzika-piezimes" />
    </section>

    <section class="artist-intake_panel" data-panel="partneris" hidden>
      <Fieldset legend="Partnera informācija" variant="columns">
        <Input
          label="Vārds vai uzņēmuma nosaukums"
          name="partnera-nosaukums"
          required
        />
        <Textarea
          label="Ko jūs darāt?"
          name="partnera-apraksts"
          placeholder="Aprakstiet pakalpojumu, specializāciju un pieredzi."
          required
        />
        <Input
          variant="url"
          label="Google Drive saite ar logo un foto"
          name="partnera-drive-saite"
          placeholder="https://drive.google.com/..."
        />
        <Textarea
          label="Mājaslapas un sociālo tīklu saites"
          name="partnera-saites"
          placeholder="Mājaslapa, Instagram, Facebook, LinkedIn u.c."
          minLines={4}
        />
        <Textarea
          label="Cenu informācija"
          name="partnera-cenas"
          placeholder="Kur atrast cenu lapu, kā tiek aprēķināta cena un aptuvenās izmaksas vienam pasākumam."
          minLines={5}
          required
        />
        <Input
          label="Kontaktpersonas vārds, uzvārds"
          name="partnera-kontaktpersona"
          required
        />
        <Input
          variant="email"
          label="E-pasts"
          name="partnera-epasts"
          required
        />
        <Input
          variant="phone"
          label="Tālrunis"
          name="partnera-talrunis"
          required
        />
      </Fieldset>
    </section>

    <ButtonWrapper
      class="artist-intake_submit"
      marginTop="4"
      hidden
      data-submit
    >
      <Button type="submit">Nosūtīt anketu</Button>
    </ButtonWrapper>
  </Form>
</div>

<script>
  for (const intake of document.querySelectorAll<HTMLElement>(
    "[data-artist-intake]",
  )) {
    const typeInput =
      intake.querySelector<HTMLInputElement>("[data-intake-type]");
    const options = intake.querySelectorAll<HTMLButtonElement>("[data-type]");
    const panels = intake.querySelectorAll<HTMLElement>("[data-panel]");
    const submit = intake.querySelector<HTMLElement>("[data-submit]");
    const genreControls = intake.querySelectorAll<HTMLInputElement>(
      "[data-genres] input",
    );
    const genreNote = intake.querySelector<HTMLElement>("[data-genre-note]");
    const otherGenre =
      intake.querySelector<HTMLInputElement>("[data-other-genre]");

    const updateGenres = () => {
      const selected = [...genreControls].filter((control) => control.checked);
      const other = [...genreControls].find(
        (control) => control.value === "Cits",
      );
      const atLimit = selected.length >= 3;
      genreControls.forEach((control) => {
        control.disabled = atLimit && !control.checked;
      });
      if (otherGenre) otherGenre.disabled = !other?.checked;
      if (genreNote)
        genreNote.textContent = selected.length
          ? `${selected.length} no 3 žanriem izvēlēti`
          : "";
    };

    options.forEach((option) => {
      option.addEventListener("click", () => {
        const selectedType = option.dataset.type;
        if (!selectedType || !typeInput) return;
        typeInput.value = selectedType;
        options.forEach((item) =>
          item.setAttribute("aria-pressed", String(item === option)),
        );
        panels.forEach((panel) => {
          const active = panel.dataset.panel === selectedType;
          panel.hidden = !active;
          panel
            .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
              "input, textarea",
            )
            .forEach((field) => {
              field.disabled = !active;
            });
        });
        if (selectedType === "grupa") updateGenres();
        if (submit) submit.hidden = false;
        intake
          .querySelector<HTMLElement>(`[data-panel="${selectedType}"]`)
          ?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    genreControls.forEach((control) =>
      control.addEventListener("change", updateGenres),
    );
    updateGenres();
    panels.forEach((panel) => {
      panel
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
          "input, textarea",
        )
        .forEach((field) => {
          field.disabled = true;
        });
    });
  }
</script>

<style is:global>
  @layer components {
    .artist-intake_wrap {
      width: min(100%, 60rem);
      margin-inline: auto;
      & [hidden] {
        display: none;
      }
    }

    .artist-intake_type {
      padding: 0;
      border: 0;
    }

    .artist-intake_label {
      padding: 0;
    }

    .artist-intake_hint {
      margin-top: var(--space-2);
      color: var(--text-2);
    }

    .artist-intake_type-list {
      display: grid;
      gap: var(--space-3);
      margin-top: var(--space-5);

      @media (width >= 48rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .artist-intake_type-option {
      display: flex;
      align-items: start;
      gap: var(--space-3);
      padding: var(--space-4);
      color: inherit;
      text-align: left;
      background: var(--background-2);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
      cursor: pointer;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);

      strong,
      small {
        display: block;
      }

      small {
        margin-top: 0.35em;
        color: var(--text-2);
      }

      &[aria-pressed="true"] {
        background: var(--text);
        border-color: var(--text);
        color: var(--background);

        small {
          color: inherit;
        }
      }

      &:focus-visible {
        outline: var(--focus-width) solid var(--text);
        outline-offset: var(--focus-offset);
      }

      @media (hover: hover) {
        &:hover:not([aria-pressed="true"]) {
          background: var(--background-3);
        }
      }
    }

    .artist-intake_type-number,
    .artist-intake_kicker {
      font-size: var(--text-small);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .artist-intake_panel {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      padding-top: var(--space-8);
    }

    .artist-intake_genres {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .artist-intake_limit {
      min-height: 1lh;
      color: var(--text-2);
    }

    .artist-intake_drive {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-5);
      background: var(--background-2);
      border-left: var(--border-width) solid var(--text);
    }

    .artist-intake_drive h3,
    .artist-intake_drive p {
      margin: 0;
    }

    .artist-intake_submit {
      justify-content: flex-start;
    }
  }
</style>
