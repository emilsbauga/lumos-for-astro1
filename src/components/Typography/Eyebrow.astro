---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type EyebrowTag = "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * What the text is written as. Defaults to `p`. The type style is fixed
   * whichever is chosen, so a label can take a heading level — where it
   * titles the section that follows it — or `span`, where it is part of a
   * sentence, without changing how it looks.
   */
  tag?: EyebrowTag;
  /**
   * How the label is drawn.
   *
   * - `default` — a marker beside the text (default)
   * - `tag` — no marker; the text sits in a filled pill
   */
  variant?: "default" | "tag";
};

const {
  render = true,
  tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const Tag = tag;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      {variant === "default" && (
        <svg
          class="eyebrow_marker"
          viewBox="0 0 8 12"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M1 4.6 4 1.6l3 3M1 10.4l3-3 3 3"
            stroke="currentColor"
            stroke-width="1.1"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      )}
      <Tag class="eyebrow_text text-style-small">
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);
      color: var(--text-2);
      font-weight: var(--primary-medium);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;

      &.tag {
        background-color: var(--text);
        color: var(--background);
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-small);
      }
      /* The logo's skujiņa rhythm, at label size: the brand mark shows up
         wherever a label does, and nowhere else. */
      .eyebrow_marker {
        flex: none;
        width: 0.5em;
        height: 0.75em;
        color: var(--heading-accent);
      }
    }
  }
</style>
