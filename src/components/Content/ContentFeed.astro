---
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/Media/Img.astro";
import Icon from "@/components/Media/Icon.astro";

interface Post {
  /** Which profile the post came from. Shown above the caption. */
  source: string;
  /** An SVG imported from `src/assets`, rendered inline beside the source. */
  icon: unknown;
  /** The post's own words, trimmed to a line or two. */
  caption: string;
  /** When it was posted, written the way it should be read. */
  date: string;
  /** Where the post lives. */
  href: string;
  /** An imported asset, a remote `http(s)` URL, or a path to a file in `public/`. */
  image: ImageMetadata;
  /** Leave unset on decorative images — renders `alt=""`. */
  imageAlt?: string;
}

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Small line of text above the heading. */
  eyebrow?: string;
  /** The section's title. */
  heading: string;
  /** Heading level, for the page outline. */
  headingTag?: "h2" | "h3";
  /** Body copy under the heading. */
  text?: string;
  /** The posts, newest first. */
  items: Post[];
  /** Label of the link out to the profile. */
  linkLabel: string;
  /** Where that link leads. */
  linkHref: string;
}

const {
  render = true,
  eyebrow,
  heading,
  headingTag = "h2",
  text,
  items,
  linkLabel,
  linkHref,
} = Astro.props;
---

{
  render && items.length > 0 && (
    <div class="feed_wrap">
      <div class="feed_head" data-reveal>
        <div class="feed_intro">
          {eyebrow && <p class="feed_eyebrow text-style-small">{eyebrow}</p>}
          <Heading
            tag={headingTag}
            class="feed_heading margin-top-0"
            maxWidth={18}
          >
            {heading}
          </Heading>
          {text && (
            <Paragraph maxWidth={44} class="feed_text">
              {text}
            </Paragraph>
          )}
        </div>
        <Button
          element="link"
          href={linkHref}
          variant="link"
          class="feed_link"
          rel="noopener"
          target="_blank"
        >
          {linkLabel}
        </Button>
      </div>

      {/* A rail rather than a grid: a feed has no last item, and on a phone
          this is how one is read anyway. */}
      <ul class="feed_rail" data-reveal>
        {items.map((item) => (
          <li class="feed_item">
            <a
              class="feed_card"
              href={item.href}
              rel="noopener"
              target="_blank"
              data-lit
            >
              <span class="feed_media">
                <Img
                  src={item.image}
                  alt={item.imageAlt}
                  variant="constrained"
                  loading="lazy"
                  sizes="(min-width: 64rem) 20rem, 70vw"
                />
              </span>
              <span class="feed_body">
                <span class="feed_source text-style-small">
                  <Icon
                    class="feed_source_mark"
                    src={item.icon as any}
                    variant="small"
                  />
                  {item.source}
                </span>
                <span class="feed_caption">{item.caption}</span>
                <span class="feed_date text-style-small">{item.date}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style is:global>
  @layer components {
    .feed_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .feed_head {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      justify-content: space-between;
      gap: var(--space-5) var(--site-gutter);
    }

    .feed_eyebrow {
      margin-bottom: var(--space-3);
      color: var(--heading-accent);
      font-weight: var(--primary-medium);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
    }

    .feed_text {
      color: var(--text-2);
    }

    /* The rail runs to the screen edge, so the last card is clearly not the
       last thing there is. */
    .feed_rail {
      display: flex;
      gap: var(--site-gutter);
      margin-inline: calc(var(--site-margin) * -1);
      padding-inline: var(--site-margin);
      padding-bottom: var(--space-3);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }

    .feed_item {
      flex: 0 0 auto;
      width: min(19rem, 72vw);
      scroll-snap-align: start;
    }

    .feed_card {
      position: relative;
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: var(--space-3);
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease),
        translate var(--hover-duration) var(--hover-ease);
    }

    .feed_media {
      display: block;
      aspect-ratio: 1;
      border-radius: calc(var(--radius-main) - var(--space-3) / 2);
      overflow: clip;
      background-color: var(--background-skeleton);

      & > .image {
        width: 100%;
        height: 100%;
        transition: scale calc(var(--hover-duration) * 3) var(--hover-ease);
      }
    }

    .feed_body {
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      gap: var(--space-2);
      padding: var(--space-4) var(--space-2) var(--space-2);
    }

    .feed_source_mark {
      width: 1.05em;
    }

    .feed_source {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--heading-accent);
      font-weight: var(--primary-medium);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
    }

    .feed_caption {
      color: var(--text);
    }

    .feed_date {
      margin-top: auto;
      padding-top: var(--space-3);
      color: var(--text-2);
    }

    @media (hover: hover) {
      .feed_card:hover {
        background-color: var(--background-3);
        border-color: color-mix(in lab, var(--text) 22%, transparent);
        translate: 0 -0.25rem;
      }
      .feed_card:hover .feed_media > .image {
        scale: 1.04;
      }
    }

    .feed_card:focus-within {
      border-color: color-mix(in lab, var(--text) 30%, transparent);
    }
  }
</style>
