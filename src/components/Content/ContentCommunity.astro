---
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Img from "@/components/Media/Img.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Small line of text above the heading. */
  eyebrow?: string;
  /** The section's title. */
  heading: string;
  /** Heading level, for the page outline. */
  headingTag?: "h2" | "h3";
  /** Body copy under the heading. */
  text: string;
  /** Label of the closing link. */
  linkLabel: string;
  /** Where that link leads. */
  linkHref: string;
  /** The photograph beside the text. An imported asset. */
  image: ImageMetadata;
  /** Leave unset on decorative images — renders `alt=""`. */
  imageAlt?: string;
}

const {
  render = true,
  eyebrow,
  heading,
  headingTag = "h2",
  text,
  linkLabel,
  linkHref,
  image,
  imageAlt,
} = Astro.props;
---

{
  render && (
    <div class="community_wrap">
      <div class="community_text" data-reveal>
        <Eyebrow>{eyebrow}</Eyebrow>
        <Heading tag={headingTag} class="community_heading" maxWidth={16}>
          {heading}
        </Heading>
        <Paragraph maxWidth={46} class="community_body">
          {text}
        </Paragraph>
        <ButtonWrapper>
          <Button element="link" href={linkHref} variant="link">
            {linkLabel}
          </Button>
        </ButtonWrapper>
      </div>
      <div class="community_media parallax" data-reveal>
        <Img
          src={image}
          alt={imageAlt}
          variant="constrained"
          sizes="(min-width: 64rem) 46vw, 100vw"
        />
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .community_wrap {
      width: 100%;
      display: grid;
      gap: var(--space-8);
      align-items: center;
    }

    .community_heading {
      margin-top: var(--space-4);
    }

    .community_body {
      color: var(--text-2);
    }

    .community_media {
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-main);
      overflow: clip;
      background-color: var(--background-2);

      & > .image {
        width: 100%;
        height: 100%;
      }
    }

    @media (width >= 64rem) {
      .community_wrap {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: var(--section-space-small);
      }

      .community_media {
        aspect-ratio: 5 / 4;
      }
    }
  }
</style>
